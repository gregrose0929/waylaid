{
  "expo": {
    "name": "Waylaid",
    "slug": "waylaid",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "waylaid",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.waylaid.app",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#C0452F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.waylaid.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF7F0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#15130F"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Waylaid uses your location to place your mailbox and to find lost letters near you.",
          "locationAlwaysAndWhenInUsePermission": "Waylaid uses your location in the background to tell you when you walk near a lost letter.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "react-native-maps",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#C0452F",
          "defaultChannel": "letters"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Waylaid lets you attach a photo to make your letter a postcard.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "127e4950-c36c-4059-8e1b-d71025ebcacc"
      }
    },
    "owner": "gregrose0929",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/127e4950-c36c-4059-8e1b-d71025ebcacc"
    }
  }
}
